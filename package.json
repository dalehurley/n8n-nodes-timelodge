{
	"name": "n8n-nodes-timelodge",
	"version": "0.1.0",
	"description": "Connect TimeLodge clients, projects, and time entries to n8n workflows.",
	"license": "MIT",
	"homepage": "https://timelodge.com",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Dale Hurley",
		"email": "support@timelodge.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/dalehurley/n8n-nodes-timelodge.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "npm run build && node --test test/*.test.cjs",
		"check": "npm run lint && npm test && prettier --check credentials nodes test package.json README.md .github/workflows/publish.yml"
	},
	"files": [
		"dist/credentials/*.js",
		"dist/nodes/**/*.js",
		"dist/nodes/**/*.json",
		"dist/nodes/**/*.svg"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TimeLodgeApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/TimeLodge/TimeLodge.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.56.4",
		"@types/node": "22.19.9",
		"eslint": "9.39.4",
		"prettier": "3.9.10",
		"release-it": "20.2.0",
		"typescript": "5.9.3",
		"n8n-workflow": "2.16.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=22.16"
	}
}
